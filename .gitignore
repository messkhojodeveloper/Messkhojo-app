# ============================================================
# FLUTTER / DART / PUB
# ============================================================
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# ============================================================
# ANDROID BUILD & LOCAL CONFIG
# ============================================================
# Machine-specific SDK paths - never share these
**/android/local.properties

# Signing config - contains passwords & keystore path
**/android/key.properties

# Release build artifacts
/android/app/release/
/android/.gradle/
/android/.kotlin/

# ============================================================
# KEYSTORE / SIGNING FILES - NEVER COMMIT, BACK UP SEPARATELY
# ============================================================
**/*.keystore
**/*.jks
**/*.keystore.old
**/*.p12

# ============================================================
# FIREBASE & GOOGLE SERVICES - SENSITIVE API KEYS
# ============================================================
# Regenerate with: flutterfire configure
**/lib/firebase_options.dart

# Regenerate from Firebase Console
**/android/app/google-services.json

# iOS equivalent
**/ios/Runner/GoogleService-Info.plist

# ============================================================
# COMPILED / RELEASE BINARIES - NEVER PUSH TO GIT
# ============================================================
*.apk
*.aab
*.ipa
*.app
*.dSYM.zip
*.dSYM

# Debug symbols folder
/debug-info/

# ============================================================
# iOS / XCODE
# ============================================================
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
**/ios/Runner.xcworkspace/xcuserdata/
**/ios/*.xcworkspace/xcuserdata/
**/*.xccheckout
**/*.moved-aside
**/*.xcscmblueprint

# ============================================================
# MISCELLANEOUS
# ============================================================
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
.FullName

# Env files
*.env
*.env.local

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# Obfuscation & symbolication
app.*.symbols
app.*.map.json

# ============================================================
# DOCKER / INFRA - not part of app source
# ============================================================
Dockerfile
.dockerignore
docker-compose.yml
nginx.conf
serve_web.js
